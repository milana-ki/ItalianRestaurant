@model ItalianRestaurant.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0 p-4 rounded-4">

                <div class="text-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-person-circle text-danger mb-2" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1 z" />
                    </svg>
                    <h3 class="fw-bold">My Profile</h3>
                    <p class="text-muted">Manage your personal information</p>
                </div>

                <form asp-controller="Account" asp-action="UpdateProfile" method="post">

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Full Name</label>
                        <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Email Address</label>
                        <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Phone Number</label>
                        <input type="text" name="Phone" class="form-control" value="@Model.Phone" required />
                    </div>

                    <button type="submit" class="btn btn-danger w-100 py-2 mb-3 fw-semibold">Save Changes</button>
                </form>

                <hr class="my-2">

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a asp-controller="Account" asp-action="Logout" class="text-decoration-none text-secondary fw-semibold">
                        <i class="bi bi-box-arrow-right"></i> Log Out
                    </a>

                    <form asp-controller="Account" asp-action="DeleteAccount" method="post" onsubmit="return confirm('Are you sure you want to delete your account?');">
                        <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 fw-semibold">Delete Account</button>
                    </form>
                </div>

            </div>

        </div>
    </div>
</div>