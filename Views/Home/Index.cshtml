@{
    ViewData["Title"] = "Bella Italia";
}

<section class="py-5 my-3 bg-light rounded-4 border shadow-sm">
    <div class="container px-4 py-3 text-center">
        <span class="badge text-bg-danger mb-3 px-3 py-2 rounded-pill">Authentic Italian Kitchen</span>
        <h1 class="display-4 fw-bold mb-3">Welcome to Bella Italia</h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 620px;">
            Wood-fired pizza, handmade pasta, and classic Italian flavors prepared fresh for delivery and dine-in.
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Menu" asp-action="Index" class="btn btn-danger btn-lg px-5 py-3 fw-semibold shadow-sm">
                Explore Menu
            </a>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark btn-lg px-4 py-3">
                Go to Cart
            </a>
        </div>
    </div>
</section>

<section class="my-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-2">Fresh Ingredients</h5>
                <p class="text-muted mb-0">
                    Classic recipes, rich sauces, and dough rested for crisp edges and soft centers.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-2">Fast Delivery</h5>
                <p class="text-muted mb-0">
                    Hot meals straight from the kitchen with clear status tracking in your account.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-2">Easy Ordering</h5>
                <p class="text-muted mb-0">
                    Pick your dishes in the menu, review your cart, and place an order in a few clicks.
                </p>
            </div>
        </div>
    </div>
</section>