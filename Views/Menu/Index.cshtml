@model IEnumerable<ItalianRestaurant.Models.Dish>

@{
    ViewData["Title"] = "Menu";
}

<div class="container my-4">
    <div class="row">
        
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 p-3 sticky-top" style="top: 20px;">
                <h5 class="fw-bold mb-3">Categories</h5>
                <nav class="nav flex-column nav-pills">
                    <a class="nav-link text-dark mb-1" href="#antipasti">Antipasti</a>
                    <a class="nav-link text-dark mb-1" href="#salads">Salads</a>
                    <a class="nav-link text-dark mb-1" href="#soups">Soups</a>
                    <a class="nav-link text-dark mb-1" href="#pasta">Pasta</a>
                    <a class="nav-link text-dark mb-1" href="#pizza">Pizza</a>
                    <a class="nav-link text-dark mb-1" href="#side-dishes">Side Dishes</a>
                    <a class="nav-link text-dark mb-1" href="#desserts">Desserts</a>
                    <a class="nav-link text-dark mb-1" href="#drinks">Drinks</a>
                </nav>
            </div>
        </div>

        <div class="col-md-9">

            <!-- 1. ANTIPASTI -->
            <section id="antipasti" class="card shadow-sm border-0 p-4 mb-4">
                <h3 class="fw-bold mb-4 border-bottom pb-2">Antipasti</h3>
                @{ var antipasti = Model.Where(d => d.Category.Name == "Antipasti").ToList(); }
                @for (int i = 0; i < antipasti.Count; i++)
                {
                    var dish = antipasti[i];
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <div class="pe-3">
                            <h5 class="fw-semibold mb-1">@dish.Name</h5>
                            <span class="text-danger fw-bold">$@dish.Price</span>
                            <p class="text-muted small mb-2">@dish.Description</p>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="dishId" value="@dish.Id" />
                                <button type="submit" class="btn btn-danger btn-sm px-3">Add to Cart</button>
                            </form>
                        </div>
                        <div>
                            <img src="~/images/@dish.ImageUrl" alt="@dish.Name" class="rounded object-fit-cover shadow-sm" style="width: 90px; height: 90px;" />
                        </div>
                    </div>
                    @if (i < antipasti.Count - 1) { <hr class="text-muted opacity-25 my-3" /> }
                }
            </section>

